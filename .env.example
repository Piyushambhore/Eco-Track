# EcoTrack Environment Variables
# Copy this to .env and fill in real values

# Server
PORT=8080

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/ecotrack
DATABASE_USERNAME=ecotrack_dev
DATABASE_PASSWORD=local_only_change_me

# JWT
JWT_SECRET=your-secret-key-min-32-characters-here
JWT_ISSUER=ecotrack
JWT_AUDIENCE=ecotrack-api

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# Logging
LOG_LEVEL=DEBUG
